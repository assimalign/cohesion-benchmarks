<Project>
	<!--
		Repository-wide defaults for every benchmark project.

		Layout convention (see CONVENTIONS.md):
		  benchmarks/libraries/<Area>/benchmarks/Assimalign.Cohesion.<Area>.Benchmarks/src/   BenchmarkDotNet suite per library area
		  benchmarks/resources/<Area>/benchmarks/Assimalign.Cohesion.<Area>.Benchmarks/src/   BenchmarkDotNet suite per resource area
		  benchmarks/resources/<Area>/benchmarks/<other projects>/src/                        end-to-end harnesses (servers, load runners)
		  harness/                                                                           shared BenchmarkDotNet conventions and the out-of-process toolkit

		Benchmarks measure Cohesion from source: CohesionRoot points at a cohesion checkout (default: the sibling
		..\cohesion), and projects reference its projects through $(CohesionLibrariesRoot) / $(CohesionResourcesRoot).
		Pass -p:CohesionRoot=<path> to measure another checkout or worktree; the harness forwards it to every
		BenchmarkDotNet child build.

		The end-to-end Web harness (benchmarks/resources/Web) consumes packed Cohesion SDKs instead and keeps its own
		Directory.Build.props.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<IsPackable>false</IsPackable>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<PropertyGroup>
		<BenchmarksRoot>$(MSBuildThisFileDirectory)</BenchmarksRoot>
		<CohesionRoot Condition="'$(CohesionRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'cohesion'))</CohesionRoot>
		<CohesionRoot>$([MSBuild]::EnsureTrailingSlash('$(CohesionRoot)'))</CohesionRoot>
		<CohesionLibrariesRoot>$(CohesionRoot)libraries\</CohesionLibrariesRoot>
		<CohesionResourcesRoot>$(CohesionRoot)resources\</CohesionResourcesRoot>
		<BenchmarksHarnessProject>$(MSBuildThisFileDirectory)harness\Assimalign.Cohesion.Benchmarks.Harness\src\Assimalign.Cohesion.Benchmarks.Harness.csproj</BenchmarksHarnessProject>
	</PropertyGroup>

	<!--
		Short output paths. BenchmarkDotNet builds a child project per job and copies cohesion's project graph into it;
		under the default bin/obj layout that exceeds MAX_PATH on Windows. Everything lands in .artifacts/ instead.
	-->
	<PropertyGroup>
		<UseArtifactsOutput>true</UseArtifactsOutput>
		<ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
	</PropertyGroup>

	<!-- A project named *.Benchmarks is a BenchmarkDotNet suite: an executable wired to the shared harness. -->
	<PropertyGroup Condition="'$(IsCohesionBenchmark)' == '' and $(MSBuildProjectName.EndsWith('.Benchmarks'))">
		<IsCohesionBenchmark>true</IsCohesionBenchmark>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsCohesionBenchmark)' == 'true'">
		<OutputType>Exe</OutputType>
		<Optimize>true</Optimize>
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<RootNamespace>$(MSBuildProjectName)</RootNamespace>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsCohesionBenchmark)' == 'true'">
		<PackageReference Include="BenchmarkDotNet" />
		<ProjectReference Include="$(BenchmarksHarnessProject)" />
		<!-- Read back by the harness: which checkout this build measures and where results go. -->
		<AssemblyMetadata Include="CohesionRoot" Value="$(CohesionRoot)" />
		<AssemblyMetadata Include="BenchmarksRoot" Value="$(BenchmarksRoot)" />
	</ItemGroup>
</Project>
