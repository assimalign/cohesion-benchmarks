<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Assimalign.Cohesion.* resolves from the Assimalign GitHub Packages feed, where cohesion's CI publishes the full
    release set for every main build (10.0.0-preview.0.ci.<run>) and every same-repository pull request build
    (10.0.0-preview.0.pr.<pr>.<run>). CohesionPackageVersion (Directory.Build.props) and the Web harness's
    global.json pin which build is measured; see CONVENTIONS.md, "Referencing Cohesion".

    No credentials in this file. GitHub Packages needs a token with read:packages even to read; supply it through
    the environment, keyed by the source name below:
      NuGetPackageSourceCredentials_assimalign = Username=<github-user>;Password=<token>
  -->
  <packageSources>
    <clear />
    <add key="assimalign" value="https://nuget.pkg.github.com/assimalign/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="assimalign">
      <package pattern="Assimalign.Cohesion.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
