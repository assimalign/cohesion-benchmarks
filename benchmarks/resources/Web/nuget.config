<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Assimalign.Cohesion.* resolves from the local feed that the sibling cohesion checkout produces with
    `pwsh installer/scripts/Install-Local.ps1 -Configuration Release -SkipLibraries`
    (10.0.0-preview.1.local, pinned in global.json). The layout assumes cohesion-benchmarks and cohesion
    are checked out side by side. To benchmark a CI build instead, add the Assimalign GitHub Packages feed
    (https://nuget.pkg.github.com/assimalign/index.json, read:packages token supplied through the
    environment) and move the global.json pins to that build's version.
  -->
  <packageSources>
    <clear />
    <add key="cohesion-local" value="../../../../cohesion/_out/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="cohesion-local">
      <package pattern="Assimalign.Cohesion.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
