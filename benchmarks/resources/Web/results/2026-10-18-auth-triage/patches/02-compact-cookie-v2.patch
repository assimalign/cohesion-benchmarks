@@ -18,6 +20,44 @@ namespace Assimalign.Cohesion.Web.Authentication.Cookie.Tests;
 
 public sealed class CookieAuthenticationHandlerTests : IDisposable
 {
+    [Fact(DisplayName = "Cohesion Test [Web.Authentication.Cookie] - Ticket serializer: compact readers accept a golden v1 ticket")]
+    public void Deserialize_LegacyV1_ShouldPreservePrincipalAndExpiration()
+    {
+        // Produced by the untouched 74976cdc5 serializer, not the proposed writer.
+        const string legacy = "";
+
+        AuthenticationTicket ticket = CookieTicketSerializer.Deserialize(Convert.FromBase64String(legacy), "Cookies");
+
+        ticket.Principal.Identity!.Name.ShouldBe("alice");
+        ticket.Principal.Identity.AuthenticationType.ShouldBe("Cookies");
+        ticket.Principal.Claims.Single().Issuer.ShouldBe(ClaimsIdentity.DefaultIssuer);
+        ticket.Properties.IssuedUtc.ShouldBe(_now);
+        ticket.Properties.ExpiresUtc.ShouldBe(_now.AddDays(14));
+    }
+
+    [Fact(DisplayName = "Cohesion Test [Web.Authentication.Cookie] - Ticket serializer: compact defaults do not collide with literal strings")]
+    public void Serialize_CustomNulStrings_ShouldRoundTripWithoutSentinelCollisions()
+    {
+        ClaimsIdentity identity = new("Cookies", "\0", "\0");
+        identity.AddClaim(new Claim("\0", "value", "\0", "\0"));
+        AuthenticationTicket ticket = new(new ClaimsPrincipal(identity),
+            new AuthenticationProperties { IssuedUtc = _now, ExpiresUtc = _now.AddDays(14) }, "Cookies");
+
+        byte[] wire = CookieTicketSerializer.Serialize(ticket);
+        AuthenticationTicket copy = CookieTicketSerializer.Deserialize(wire, "Cookies");
+
+        wire[0].ShouldBe((byte)2);
+        ClaimsIdentity restored = copy.Principal.Identities.Single();
+        restored.NameClaimType.ShouldBe("\0");
+        restored.RoleClaimType.ShouldBe("\0");
+        Claim claim = restored.Claims.Single();
+        claim.Type.ShouldBe("\0");
+        claim.ValueType.ShouldBe("\0");
+        claim.Issuer.ShouldBe("\0");
+        copy.Principal.IsInRole("value").ShouldBeTrue();
+        copy.Properties.ExpiresUtc.ShouldBe(ticket.Properties.ExpiresUtc);
+    }
+
     private static readonly DateTimeOffset _now = new(2026, 7, 8, 12, 0, 0, TimeSpan.Zero);
     private static readonly IPEndPoint _trustedProxy = new(IPAddress.Parse("10.0.0.2"), 51000);
     private static readonly IPEndPoint _untrustedPeer = new(IPAddress.Parse("198.51.100.7"), 51000);
