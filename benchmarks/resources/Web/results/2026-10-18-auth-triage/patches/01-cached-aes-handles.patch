 using System;
 using System.Text;
+using System.Threading.Tasks;
 
 using Shouldly;
 
 using Xunit;
 
+using Assimalign.Cohesion.Security.DataProtection.Internal;
+
 namespace Assimalign.Cohesion.Security.DataProtection.Tests;
 
 public class DataProtectorTests
 {
+    [Fact(DisplayName = "Cohesion Test [Security.DataProtection] - Unprotect: concurrent valid and invalid tags remain independent")]
+    public void Unprotect_ConcurrentValidAndInvalidTags_ShouldVerifyEachCall()
+    {
+        IDataProtector protector = CreateProvider().CreateProtector("purpose");
+        byte[] valid = protector.Protect(_sample);
+        byte[] invalid = (byte[])valid.Clone();
+        invalid[^1] ^= 1;
+        protector.Unprotect(valid).ShouldBe(_sample);
+
+        Parallel.For(0, 512, i =>
+        {
+            if ((i & 1) == 0)
+            {
+                protector.Unprotect(valid).ShouldBe(_sample);
+            }
+            else
+            {
+                Should.Throw<DataProtectionException>(() => protector.Unprotect(invalid));
+            }
+        });
+
+        protector.Unprotect(valid).ShouldBe(_sample);
+    }
+
+    [Fact(DisplayName = "Cohesion Test [Security.DataProtection] - Unprotect: a warmed handle does not bypass reloaded revocation")]
+    public void Unprotect_AfterRevocationReload_ShouldRejectPreviouslyAcceptedPayload()
+    {
+        InMemoryKeyRepository repository = new();
+        IDataProtector protector = DataProtectionProvider.Create(repository).CreateProtector("purpose");
+        byte[] valid = protector.Protect(_sample);
+        protector.Unprotect(valid).ShouldBe(_sample);
+        KeyDocument document = repository.GetAllKeys()[0];
+        KeySerializer.TryDeserialize(document.Content.Span, out ManagedKey? key).ShouldBeTrue();
+        key.ShouldNotBeNull();
+        repository.StoreKey(KeySerializer.Serialize(new ManagedKey(key.KeyId, key.CreatedAt,
+            key.ActivatedAt, key.ExpiresAt, isRevoked: true, key.Master.ToArray())));
+
+        byte[] unknown = new byte[45];
+        unknown[0] = 1;
+        Guid.NewGuid().TryWriteBytes(unknown.AsSpan(1, 16));
+        Should.Throw<DataProtectionException>(() => protector.Unprotect(unknown));
+
+        Should.Throw<DataProtectionException>(() => protector.Unprotect(valid))
+            .Message.ShouldContain("revoked", Case.Sensitive);
+    }
+
     private static readonly byte[] _sample = Encoding.UTF8.GetBytes("cohesion-data-protection-sample-payload");
 
     private static DataProtectionProvider CreateProvider(string discriminator = "app")
