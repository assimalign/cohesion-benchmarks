<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!-- SqlClient requires culture data even when every workload comparison uses binary collation. -->
		<InvariantGlobalization>false</InvariantGlobalization>
		<RootNamespace>Assimalign.Cohesion.Benchmarks.Database.Cli</RootNamespace>
		<AssemblyName>dbbench</AssemblyName>
		<Description>The dbbench command line: generate, load, verify, run, report, env.</Description>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<UsesCohesionSource>true</UsesCohesionSource>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Assimalign.Cohesion.Benchmarks.Database.Harness\Assimalign.Cohesion.Benchmarks.Database.Harness.csproj" />
		<ProjectReference Include="..\Assimalign.Cohesion.Benchmarks.Database.Datasets\Assimalign.Cohesion.Benchmarks.Database.Datasets.csproj" />
		<ProjectReference Include="..\Assimalign.Cohesion.Benchmarks.Database.Sql\Assimalign.Cohesion.Benchmarks.Database.Sql.csproj" />
		<ProjectReference Include="..\Assimalign.Cohesion.Benchmarks.Database.Documents\Assimalign.Cohesion.Benchmarks.Database.Documents.csproj" />
		<ProjectReference Include="..\Assimalign.Cohesion.Benchmarks.Database.Graph\Assimalign.Cohesion.Benchmarks.Database.Graph.csproj" />
	</ItemGroup>
</Project>
