FROM mcr.microsoft.com/dotnet/runtime-deps:10.0
ARG BENCHMARKS_COMMIT
ARG BENCHMARKS_DIRTY
ARG COHESION_COMMIT
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 DBBENCH_BENCHMARKS_COMMIT=$BENCHMARKS_COMMIT DBBENCH_COHESION_COMMIT=$COHESION_COMMIT
ENV DBBENCH_BENCHMARKS_DIRTY=$BENCHMARKS_DIRTY
WORKDIR /app
COPY publish/ ./
STOPSIGNAL SIGTERM
EXPOSE 5740
ENTRYPOINT ["/app/cohesion-db-server"]
