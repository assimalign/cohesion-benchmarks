FROM mcr.microsoft.com/dotnet/runtime-deps:10.0
ARG BENCHMARKS_COMMIT
ARG BENCHMARKS_DIRTY
ARG COHESION_COMMIT
ENV DBBENCH_NETWORK=1 DBBENCH_CATALOG=/app/engines/catalog.json DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
ENV DBBENCH_BENCHMARKS_COMMIT=$BENCHMARKS_COMMIT DBBENCH_COHESION_COMMIT=$COHESION_COMMIT
ENV DBBENCH_BENCHMARKS_DIRTY=$BENCHMARKS_DIRTY
WORKDIR /app
COPY publish/ ./
COPY engines/ ./engines/
ENTRYPOINT ["/app/dbbench"]
