{
  "schemaVersion": 1,
  "network": "dbbench",
  "defaultCpus": 3,
  "defaultMemory": "6g",
  "developmentCredentialsOnly": true,
  "targets": [
    {
      "id": "postgresql",
      "model": "sql",
      "kind": "container",
      "image": "docker.io/library/postgres:17",
      "containerName": "dbbench-postgresql",
      "networkAlias": "dbbench-postgresql",
      "ports": [
        {
          "internal": 5432,
          "published": 55432
        }
      ],
      "endpointTemplate": "postgresql://{host}:{port}",
      "credentials": {
        "username": "dbbench",
        "password": "Dbbench-Local-2026!"
      },
      "environment": {
        "POSTGRES_USER": "{username}",
        "POSTGRES_PASSWORD": "{password}",
        "POSTGRES_DB": "benchmark"
      },
      "volume": "dbbench-postgresql-data",
      "mountPath": "/var/lib/postgresql/data",
      "arguments": [
        "-c",
        "shared_buffers=1536MB",
        "-c",
        "effective_cache_size=4GB",
        "-c",
        "work_mem=64MB",
        "-c",
        "maintenance_work_mem=1GB",
        "-c",
        "max_wal_size=8GB",
        "-c",
        "checkpoint_timeout=15min",
        "-c",
        "random_page_cost=1.1",
        "-c",
        "max_parallel_workers_per_gather=2",
        "-c",
        "synchronous_commit=on",
        "-c",
        "fsync=on"
      ],
      "readiness": {
        "kind": "exec",
        "command": [
          "pg_isready",
          "-U",
          "{username}",
          "-d",
          "benchmark"
        ]
      },
      "settings": [
        {
          "name": "shared_buffers",
          "value": "1536MB",
          "reason": "DESIGN §8 shared 6 GiB budget and SSD/checkpoint policy."
        },
        {
          "name": "effective_cache_size",
          "value": "4GB",
          "reason": "DESIGN §8 shared 6 GiB budget and SSD/checkpoint policy."
        },
        {
          "name": "work_mem",
          "value": "64MB",
          "reason": "DESIGN §8 shared 6 GiB budget and SSD/checkpoint policy."
        },
        {
          "name": "maintenance_work_mem",
          "value": "1GB",
          "reason": "DESIGN §8 shared 6 GiB budget and SSD/checkpoint policy."
        },
        {
          "name": "max_wal_size",
          "value": "8GB",
          "reason": "DESIGN §8 shared 6 GiB budget and SSD/checkpoint policy."
        },
        {
          "name": "checkpoint_timeout",
          "value": "15min",
          "reason": "DESIGN §8 shared 6 GiB budget and SSD/checkpoint policy."
        },
        {
          "name": "random_page_cost",
          "value": "1.1",
          "reason": "DESIGN §8 shared 6 GiB budget and SSD/checkpoint policy."
        },
        {
          "name": "max_parallel_workers_per_gather",
          "value": "2",
          "reason": "DESIGN §8 shared 6 GiB budget and SSD/checkpoint policy."
        },
        {
          "name": "synchronous_commit",
          "value": "on",
          "reason": "Durable acknowledgement required by shared methodology."
        },
        {
          "name": "fsync",
          "value": "on",
          "reason": "Durable acknowledgement required by shared methodology."
        }
      ]
    },
    {
      "id": "sqlserver",
      "model": "sql",
      "kind": "container",
      "image": "mcr.microsoft.com/azure-sql-edge:latest",
      "containerName": "dbbench-sqlserver",
      "networkAlias": "dbbench-sqlserver",
      "ports": [
        {
          "internal": 1433,
          "published": 51433
        }
      ],
      "endpointTemplate": "tcp://{host}:{port}",
      "credentials": {
        "username": "sa",
        "password": "Dbbench-Local-2026!"
      },
      "environment": {
        "ACCEPT_EULA": "Y",
        "MSSQL_PID": "Developer",
        "MSSQL_SA_PASSWORD": "{password}",
        "MSSQL_MEMORY_LIMIT_MB": "4608"
      },
      "volume": "dbbench-sqlserver-data",
      "mountPath": "/var/opt/mssql",
      "arguments": ["/opt/mssql/bin/sqlservr"],
      "readiness": {
        "kind": "log",
        "pattern": "SQL Server is now ready for client connections"
      },
      "settings": [
        {
          "name": "ACCEPT_EULA",
          "value": "Y",
          "reason": "Owner decision 2026-10-15."
        },
        {
          "name": "MSSQL_PID",
          "value": "Developer",
          "reason": "Development benchmark edition."
        },
        {
          "name": "MSSQL_MEMORY_LIMIT_MB",
          "value": "4608",
          "reason": "Leave 1.5 GiB of the shared budget for operating system and overhead."
        },
        {
          "name": "recovery model",
          "value": "SIMPLE",
          "reason": "No log backups exist; adapter applies sqlserver/prepare.sql after creating benchmark database."
        },
        {
          "name": "DELAYED_DURABILITY",
          "value": "DISABLED",
          "reason": "Full synchronous commit durability."
        }
      ],
      "label": "SQL Server engine via Azure SQL Edge",
      "configFile": "sqlserver/prepare.sql"
    },
    {
      "id": "mongodb",
      "model": "documents",
      "kind": "container",
      "image": "docker.io/library/mongo:8.0",
      "containerName": "dbbench-mongodb",
      "networkAlias": "dbbench-mongodb",
      "ports": [
        {
          "internal": 27017,
          "published": 57017
        }
      ],
      "endpointTemplate": "mongodb://{host}:{port}",
      "credentials": {
        "username": "dbbench",
        "password": "Dbbench-Local-2026!"
      },
      "environment": {
        "MONGO_INITDB_ROOT_USERNAME": "{username}",
        "MONGO_INITDB_ROOT_PASSWORD": "{password}"
      },
      "volume": "dbbench-mongodb-data",
      "mountPath": "/data/db",
      "arguments": [
        "--wiredTigerCacheSizeGB",
        "2.5"
      ],
      "readiness": {
        "kind": "exec",
        "command": [
          "mongosh",
          "--quiet",
          "--username",
          "{username}",
          "--password",
          "{password}",
          "--authenticationDatabase",
          "admin",
          "--eval",
          "quit(db.adminCommand({ping:1}).ok === 1 ? 0 : 1)"
        ]
      },
      "settings": [
        {
          "name": "wiredTigerCacheSizeGB",
          "value": "2.5",
          "reason": "DESIGN §8 shared 6 GiB host guidance."
        },
        {
          "name": "writeConcern",
          "value": "w:1,j:true",
          "reason": "Adapter must require journal acknowledgement on every write."
        }
      ]
    },
    {
      "id": "ravendb",
      "model": "documents",
      "kind": "container",
      "image": "docker.io/ravendb/ravendb:7.1-latest",
      "containerName": "dbbench-ravendb",
      "networkAlias": "dbbench-ravendb",
      "ports": [
        {
          "internal": 8080,
          "published": 58080
        }
      ],
      "endpointTemplate": "http://{host}:{port}",
      "credentials": {},
      "environment": {
        "RAVEN_Setup_Mode": "None",
        "RAVEN_License_Eula_Accepted": "true",
        "RAVEN_Security_UnsecuredAccessAllowed": "PublicNetwork",
        "RAVEN_ServerUrl": "http://0.0.0.0:8080"
      },
      "volume": "dbbench-ravendb-data",
      "mountPath": "/var/lib/ravendb/data",
      "arguments": [],
      "readiness": {
        "kind": "http",
        "path": "/build/version",
        "scheme": "http"
      },
      "settings": [
        {
          "name": "Setup.Mode",
          "value": "None",
          "reason": "Disable interactive setup wizard for repeatable local startup."
        },
        {
          "name": "License.Eula.Accepted",
          "value": "true",
          "reason": "Owner decision 2026-10-15."
        },
        {
          "name": "Security.UnsecuredAccessAllowed",
          "value": "PublicNetwork",
          "reason": "Local isolated Podman development network and loopback published ports; no certificate ceremony."
        },
        {
          "name": "ServerUrl",
          "value": "http://0.0.0.0:8080",
          "reason": "Accept driver network connections."
        },
        {
          "name": "indexes",
          "value": "wait for non-stale",
          "reason": "Adapter must await index catch-up before measurement."
        }
      ]
    },
    {
      "id": "neo4j",
      "model": "graph",
      "kind": "container",
      "image": "docker.io/library/neo4j:5-community",
      "containerName": "dbbench-neo4j",
      "networkAlias": "dbbench-neo4j",
      "ports": [
        {
          "internal": 7687,
          "published": 57687
        },
        {
          "internal": 7474,
          "published": 57474
        }
      ],
      "endpointTemplate": "bolt://{host}:{port}",
      "credentials": {
        "username": "neo4j",
        "password": "Dbbench-Local-2026!"
      },
      "environment": {
        "NEO4J_AUTH": "{username}/{password}",
        "NEO4J_server_memory_heap_initial__size": "1536m",
        "NEO4J_server_memory_heap_max__size": "1536m",
        "NEO4J_server_memory_pagecache_size": "3g"
      },
      "volume": "dbbench-neo4j-data",
      "mountPath": "/data",
      "arguments": [],
      "readiness": {
        "kind": "exec",
        "command": [
          "cypher-shell",
          "-u",
          "{username}",
          "-p",
          "{password}",
          "RETURN 1;"
        ]
      },
      "settings": [
        {
          "name": "server.memory.heap.initial_size",
          "value": "1536m",
          "reason": "DESIGN §8 fixed heap within 6 GiB."
        },
        {
          "name": "server.memory.heap.max_size",
          "value": "1536m",
          "reason": "Keep heap size constant across repetitions."
        },
        {
          "name": "server.memory.pagecache.size",
          "value": "3g",
          "reason": "DESIGN §8 shared cache allocation."
        },
        {
          "name": "NEO4J_AUTH",
          "value": "catalog development credentials",
          "reason": "Deterministic local authentication; transaction log flushing remains default."
        }
      ]
    },
    {
      "id": "cohesion-sql-tcp",
      "model": "sql",
      "kind": "container",
      "image": "localhost/dbbench-cohesion-server:dev",
      "containerName": "dbbench-cohesion-sql",
      "networkAlias": "dbbench-cohesion-sql",
      "ports": [
        {
          "internal": 5740,
          "published": 55740
        }
      ],
      "endpointTemplate": "tcp://{host}:{port}",
      "credentials": {
        "principal": "dbbench"
      },
      "environment": {},
      "volume": "dbbench-cohesion-sql-data",
      "mountPath": "/data",
      "arguments": [
        "--model",
        "sql",
        "--data",
        "/data",
        "--port",
        "5740",
        "--database",
        "benchmark",
        "--buffer-pool-mb",
        "3072",
        "--durability",
        "synchronous",
        "--engine-name",
        "benchmark-sql"
      ],
      "readiness": {
        "kind": "cohesion",
        "pattern": "READY sql port=5740"
      },
      "settings": [
        {
          "name": "BufferPoolCapacity",
          "value": "3221225472",
          "reason": "3 GiB per database per DESIGN §8."
        },
        {
          "name": "Durability",
          "value": "Synchronous",
          "reason": "Acknowledgement only after durable flush."
        },
        {
          "name": "RootPath",
          "value": "/data",
          "reason": "Embedded-loaded files in a named volume."
        }
      ],
      "servesLoadedDataFrom": "cohesion-sql-embedded"
    },
    {
      "id": "cohesion-graph-tcp",
      "model": "graph",
      "kind": "container",
      "image": "localhost/dbbench-cohesion-server:dev",
      "containerName": "dbbench-cohesion-graph",
      "networkAlias": "dbbench-cohesion-graph",
      "ports": [
        {
          "internal": 5740,
          "published": 55741
        }
      ],
      "endpointTemplate": "tcp://{host}:{port}",
      "credentials": {
        "principal": "dbbench"
      },
      "environment": {},
      "volume": "dbbench-cohesion-graph-data",
      "mountPath": "/data",
      "arguments": [
        "--model",
        "graph",
        "--data",
        "/data",
        "--port",
        "5740",
        "--database",
        "benchmark",
        "--buffer-pool-mb",
        "3072",
        "--durability",
        "synchronous",
        "--engine-name",
        "benchmark-graph"
      ],
      "readiness": {
        "kind": "cohesion",
        "pattern": "READY graph port=5740"
      },
      "settings": [
        {
          "name": "BufferPoolCapacity",
          "value": "3221225472",
          "reason": "3 GiB per database per DESIGN §8."
        },
        {
          "name": "Durability",
          "value": "Synchronous",
          "reason": "Acknowledgement only after durable flush."
        },
        {
          "name": "RootPath",
          "value": "/data",
          "reason": "Embedded-loaded files in a named volume."
        }
      ],
      "servesLoadedDataFrom": "cohesion-graph-embedded"
    },
    {
      "id": "cohesion-sql-embedded",
      "model": "sql",
      "kind": "embedded",
      "image": "localhost/dbbench-driver:dev",
      "containerName": "dbbench-driver",
      "networkAlias": "dbbench-driver",
      "ports": [],
      "environment": {},
      "credentials": {},
      "volume": "dbbench-cohesion-sql-data",
      "mountPath": "/engine-data",
      "arguments": [],
      "readiness": {
        "kind": "cli"
      },
      "settings": [
        {
          "name": "BufferPoolCapacity",
          "value": "3221225472",
          "reason": "3 GiB per database per DESIGN §8."
        },
        {
          "name": "Durability",
          "value": "Synchronous",
          "reason": "Same durable commits as TCP and competitors."
        }
      ]
    },
    {
      "id": "cohesion-documents-embedded",
      "model": "documents",
      "kind": "embedded",
      "image": "localhost/dbbench-driver:dev",
      "containerName": "dbbench-driver",
      "networkAlias": "dbbench-driver",
      "ports": [],
      "environment": {},
      "credentials": {},
      "volume": "dbbench-cohesion-documents-data",
      "mountPath": "/engine-data",
      "arguments": [],
      "readiness": {
        "kind": "cli"
      },
      "settings": [
        {
          "name": "BufferPoolCapacity",
          "value": "3221225472",
          "reason": "3 GiB per database per DESIGN §8."
        },
        {
          "name": "Durability",
          "value": "Synchronous",
          "reason": "Same durable commits as TCP and competitors."
        }
      ]
    },
    {
      "id": "cohesion-graph-embedded",
      "model": "graph",
      "kind": "embedded",
      "image": "localhost/dbbench-driver:dev",
      "containerName": "dbbench-driver",
      "networkAlias": "dbbench-driver",
      "ports": [],
      "environment": {},
      "credentials": {},
      "volume": "dbbench-cohesion-graph-data",
      "mountPath": "/engine-data",
      "arguments": [],
      "readiness": {
        "kind": "cli"
      },
      "settings": [
        {
          "name": "BufferPoolCapacity",
          "value": "3221225472",
          "reason": "3 GiB per database per DESIGN §8."
        },
        {
          "name": "Durability",
          "value": "Synchronous",
          "reason": "Same durable commits as TCP and competitors."
        }
      ]
    }
  ]
}
